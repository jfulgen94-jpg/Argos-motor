# STATER Motor Argos — Environment Variables Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Runtime environment
STATER_ENV=local                           # 'local' | 'azure'

# Azure Blob Storage (Microsoft Founders Hub credits)
AZURE_STORAGE_CONNECTION_STRING=...
AZURE_BLOB_CONTAINER_RAW=stater-raw-filings

# Azure OpenAI (Phase 1+, use Founders Hub credits)
AZURE_OPENAI_KEY=...
AZURE_OPENAI_ENDPOINT=https://stater-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Ollama (local, Phase 0)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=stater-audit

# API Gateway
STATER_API_HOST=0.0.0.0
STATER_API_PORT=8000
STATER_API_KEY_ADMIN=change-me-before-production
