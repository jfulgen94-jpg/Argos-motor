      "type": "string"
    },
    "doc_id": {
      "type": "string"
    },
    "entity_lei": {
      "type": "string"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "concept": {
      "type": "string"
    },
    "concept_std": {
      "type": "string"
    },
    "value": {
      "type": "number"
