# ==============================================================================
# STATER MOTOR ARGOS — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a '.env' y completa con tus credenciales.
# NUNCA subas el archivo '.env' a repositorios públicos de Git.

# --- 1. ENTORNO Y EJECUCIÓN ---
STATER_ENV=production
PYTHONUNBUFFERED=1
ARGOS_HEADLESS=1

# --- 2. RUTAS DEL DATA LAKE Y PERSISTENCIA ---
# En servidor / contenedor cloud Linux (Qwen Coder Studio / OpenHands):
ARGOS_DATA_ROOT=/workspace/data
STATER_DUCKDB_PATH=/workspace/data/lake/duckdb/stater_motor.duckdb
STATER_LOG_DIR=/workspace/logs

# En entorno local Windows (referencia):
# ARGOS_DATA_ROOT=D:/ARGOS_DATA
# STATER_DUCKDB_PATH=D:/ARGOS_DATA/lake/duckdb/stater_motor.duckdb

# --- 3. NAVEGADORES HEADLESS (PLAYWRIGHT) ---
# 0 para usar la ruta del sistema /root/.cache/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=0

# --- 4. DATA LAKE REMOTO (AZURE BLOB STORAGE) ---
# Opcional: para sincronizar automáticamente los archivos descargados a la nube
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_RAW=stater-raw-filings
AZURE_BLOB_CONTAINER_LAKE=stater-lake-curated

# --- 5. MODELOS IA / LLM (OPCIONAL: MÓDULOS DE AUDITORÍA Y NLP) ---
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://stater-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=stater-audit

# --- 6. API GATEWAY INSTITUCIONAL (FASTAPI) ---
STATER_API_HOST=0.0.0.0
STATER_API_PORT=8000
STATER_API_KEY_ADMIN=stater-admin-secret-key-2026
